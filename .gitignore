# =============================================================================
# CS2 TCC — .gitignore
# =============================================================================

# Banco de dados
*.db
*.sqlite
*.sqlite3

# Demos (arquivos grandes)
*.dem

# Datasets exportados
*.csv
*.parquet
*.feather
*.jsonl

# Plots gerados
plots/
*.png
*.jpg
*.pdf

# Exceção: imagens de radar são assets necessários para os heatmaps da EDA
!assets/maps/*.png

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/

# Ambiente virtual
venv/
.venv/
env/
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/